# 复制为 .env 后修改。Compose 用这里的管理员密码和 JWT 密钥；数据库地址在 compose 内会改写为 postgres 服务。
T_AGNET_DATABASE_URL=postgresql+psycopg://tagent:tagent@localhost:5432/tagent
T_AGNET_ADMIN_PASSWORD=change-me-please
T_AGNET_JWT_SECRET=change-me-to-a-long-random-string
# 可选
# T_AGNET_JWT_TTL_SECONDS=3600
# T_AGNET_PRESENCE_TTL_SECONDS=60
# T_AGNET_PAIRING_TTL_SECONDS=600
# T_AGNET_SIGNATURE_SKEW_SECONDS=300
# T_AGNET_APPROVAL_TTL_SECONDS=900
# T_AGNET_COMMAND_TTL_SECONDS=86400
# 模型密钥同步：使用 scripts/vault_key.py 生成文件；只填写路径，禁止填主密钥原文。
# T_AGNET_SYNC_KEY_FILE=/absolute/path/to/sync-vault.json
# 云端问答（worker）：云端模型密钥同样依赖上面的加密文件。
# T_AGNET_TAVILY_API_KEY=tvly-...        # 不填则云端问答不联网
# T_AGNET_WORKER_LEASE_SECONDS=60
