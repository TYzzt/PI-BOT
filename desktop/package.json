{
  "name": "t-agnet-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node_modules/node/bin/node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:keychain": "T_AGNET_TEST_KEYCHAIN=1 node_modules/node/bin/node --import tsx --test tests/keychain.test.ts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "diff": "9.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "typebox": "1.3.27",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "node": "24.21.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
